{
  "manifest_version": 3,
  "name": "WA Chats Backup Pro",
  "version": "1.2.0",
  "description": "Export WhatsApp Web chats as Markdown with images, videos and documents. One-click toolbar backup like Chats Backup for wa.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "lib/zip.js",
        "content/dom.js",
        "content/parser.js",
        "content/exporter.js",
        "content/ui.js",
        "content/main.js"
      ],
      "css": ["content/styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "WA Chats Backup Pro",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
