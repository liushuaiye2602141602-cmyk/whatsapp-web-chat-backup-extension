{
  "manifest_version": 3,
  "name": "WA Chats Backup Pro",
  "version": "1.4.0",
  "description": "Export WhatsApp Web chats via WPPConnect Store as Markdown, HTML and ZIP with media.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://*.whatsapp.com/*",
    "https://*.whatsapp.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*", "https://*.whatsapp.com/*"],
      "js": [
        "lib/zip.js",
        "content/wpp.js",
        "content/exporter.js",
        "content/ui.js",
        "content/main.js"
      ],
      "css": ["content/styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/wppconnect-wa.js",
        "injected.js"
      ],
      "matches": ["https://web.whatsapp.com/*", "https://*.whatsapp.com/*"]
    }
  ],
  "action": {
    "default_title": "WA Chats Backup Pro",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
